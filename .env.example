# Copy to .env and fill in. Only needed for `docker compose run --rm ask`
# (answer generation) -- `ingest` and `tests` don't need a Groq key at all.
GROQ_API_KEY=

# Override if the default model below gets deprecated/renamed.
# GROQ_MODEL=llama-3.3-70b-versatile

# Only needed if Day 1's API isn't at the default http://host.docker.internal:8000.
# DOCUMENTS_API_BASE_URL=http://host.docker.internal:8000
